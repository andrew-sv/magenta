# Magenta — local environment
#
# Claude auth is NOT in this file. Run `claude login` once to authenticate
# the Claude Agent SDK against your Pro/Max subscription.

# Default assumes a Homebrew Postgres install: the database role is your macOS
# login user, no password. Run `createdb magenta` once to make the database.
# If your local Postgres uses different credentials, override accordingly.
DATABASE_URL=postgres://asventytskyi@localhost:5432/magenta

# Ollama is reached over HTTP. Native install on the host is recommended on macOS
# (Docker lacks GPU passthrough). `ollama serve` exposes port 11434 by default.
OLLAMA_BASE_URL=http://localhost:11434
# native = ollama-ai-provider-v2 (default). openai = OpenAI-compatible fallback.
OLLAMA_MODE=native

# Case 3 — number of B-questions before the loop stops.
DEFAULT_LOOP_ROUNDS=3

# Case 6 — ComfyUI. The desktop app binds to 127.0.0.1:8000 by default; if you
# run the CLI distribution it usually binds to 127.0.0.1:8188.
COMFYUI_BASE_URL=http://127.0.0.1:8000

# 403 any non-loopback request to /api/*. Keep "true" unless you know what you're doing.
MAGENTA_LOCAL_ONLY=true
